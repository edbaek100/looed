# Copy to .env for LOCAL development. Never commit .env.
# Fill in your own 12+ character shared entrance password.
APP_PASSWORD=
# Generate a 32+ character random value, e.g. openssl rand -hex 32.
SESSION_SECRET=
# Optional locally, REQUIRED on Render. Use the legacy service_role key, never anon.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
